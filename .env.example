# --- Phase 1 ---
APP_ENV=local                       # local | dev | prod
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8000  # used by UI
CORS_ORIGINS=http://localhost:8501
DATABASE_URL=sqlite:///./data/whattowatch.db
JWT_SECRET_KEYS=change-me           # comma-separated; first = signing key (rotation); outside APP_ENV=local each key must be >= 32 bytes
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=7
TMDB_API_KEY=<enter your api key>
TMDB_READ_TOKEN=<enter your token>
TMDB_MAX_CONCURRENCY=20
TMDB_TIMEOUT_SECONDS=10
TMDB_MAX_ATTEMPTS=4                 # first try + retries (5xx / 429 / network)
SEED_LANGUAGES=en,hi,ko,ja,es,fr,ta,te,ml
SEED_COUNTRIES=US
DEFAULT_COUNTRY=US
INGEST_PAGES_PER_LANGUAGE=10
PROVIDERS_TTL_DAYS=7               # refresh a country's cached provider list after N days (P1-07)
TITLE_SEARCH_CACHE_TTL_SECONDS=300 # in-process cache of TMDB title searches; 0 disables (P1-08)
TITLE_SEARCH_CACHE_MAX_ENTRIES=1000
# open content (P1-04b, D-011): Wikidata + Wikipedia
WIKIMEDIA_CONTACT=<add>                  # required by Wikimedia's User-Agent policy (email or URL); open-content refuses to run without it
WIKIMEDIA_CONCURRENCY=4
WIKIMEDIA_TIMEOUT_SECONDS=30        # SPARQL batches can be slow
WIKIMEDIA_MAX_ATTEMPTS=4            # first try + retries (5xx / 429 / network)
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDINGS_DIR=./data
EMBED_BATCH_SIZE=32                 # CPU-friendly encode batch
ONEHOT_ENABLED=false                # optional one-hot block (§8.1)
ONEHOT_WEIGHT=0.15
ONEHOT_GENRE_VOCAB=40               # most frequent Wikidata genre labels in the one-hot block
VECTOR_BACKEND=numpy                # numpy | pgvector (P2)
# recommender tunables (hashed into config_hash)
REC_N_DEFAULT=10
CANDIDATES_SIMILAR=500
CANDIDATES_TRENDING=100
W_SIM=0.70
W_QUAL=0.0                          # D-017: TMDB-derived, off until TMDB permission (spec 0.15)
W_POP=0.0                           # D-017: TMDB-derived, off until TMDB permission (spec 0.10)
W_REC=0.05
W_NEG=0.0                           # negative-profile penalty (§8.2), off in Phase 1
BAYES_M=200
RECENCY_HALF_LIFE_DAYS=365
PROFILE_HALF_LIFE_DAYS=90
MMR_LAMBDA=0.7
CAP_PER_LANGUAGE=4
CAP_PER_GENRE=3
MAX_RUNTIME_APPLIES_TO_TV=false     # §8.4: max runtime filters movies only by default
AVAILABILITY_TTL_DAYS=7
AVAILABILITY_BUFFER=3
AVAILABILITY_MAX_FETCHES_PER_REQUEST=60
ADULT_CERTIFICATIONS={"US":["NC-17"]}

# --- Phase 2 ---
# Docker stack (P2-01, `make dev`): read by docker-compose.yml, not by the app. Inside the
# containers DATABASE_URL / REDIS_URL / API_BASE_URL are overridden to the compose services.
POSTGRES_USER=whattowatch
POSTGRES_PASSWORD=whattowatch      # local dev only; change it if you expose the port
POSTGRES_DB=whattowatch
POSTGRES_PORT=5432                 # host ports (bound to 127.0.0.1)
REDIS_PORT=6379
API_PORT=8000
UI_PORT=8501
